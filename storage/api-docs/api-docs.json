{
    "openapi": "3.0.0",
    "info": {
        "title": "LinkedMeet API",
        "description": "API documentation for LinkedMeet app",
        "version": "1.0.0"
    },
    "paths": {
        "/api": {},
        "/api/v1/app/check-version": {
            "get": {
                "tags": [
                    "App"
                ],
                "summary": "Check for app version and update status",
                "description": "Checks the current app version against the latest version and returns whether an update is available, and if so, whether it's mandatory.",
                "operationId": "checkVersion",
                "parameters": [
                    {
                        "name": "current_version",
                        "in": "query",
                        "description": "The current version of the app",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "example": "1.1.3"
                        }
                    },
                    {
                        "name": "platform",
                        "in": "query",
                        "description": "The platform of the app (android, ios, or web)",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "android",
                                "ios",
                                "web"
                            ],
                            "example": "android"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "App version information and update status",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "current_version": {
                                            "description": "Current version of the app",
                                            "type": "string",
                                            "example": "1.1.3"
                                        },
                                        "latest_version": {
                                            "description": "Latest version of the app",
                                            "type": "string",
                                            "example": "1.2.0"
                                        },
                                        "is_mandatory": {
                                            "description": "Indicates if the update is mandatory",
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "description": "Message to the user regarding the update status",
                                            "type": "string",
                                            "example": "A new version is available. Do you want to update?"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Platform not found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Platform not found."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation error - The request parameters are not valid",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "description": "A general error message",
                                            "type": "string",
                                            "example": "The selected platform is invalid. (and 1 more error)"
                                        },
                                        "errors": {
                                            "description": "An object containing validation errors for each parameter",
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/auth/register": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Register a new user",
                "description": "This endpoint allows a user to register by providing their name, email, and password. After registration, an email verification code will be sent to the user.",
                "operationId": "registerUser",
                "requestBody": {
                    "description": "User registration data",
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "name": {
                                        "description": "Full name of the user",
                                        "type": "string",
                                        "example": "John Doe"
                                    },
                                    "email": {
                                        "description": "Email address of the user",
                                        "type": "string",
                                        "format": "email",
                                        "example": "john.doe@example.com"
                                    },
                                    "password": {
                                        "description": "Password for the user account",
                                        "type": "string",
                                        "example": "password123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "User successfully registered",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Registration successful. A verification code has been sent to your email."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation errors",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Validation failed"
                                        },
                                        "errors": {
                                            "description": "An object containing validation errors for each parameter",
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/auth/resend-verification-code": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Resend Email Verification Code",
                "description": "Resend a 6-digit email verification code. Ensures the code is not resent if the previous one is still valid.",
                "operationId": "3968a07fd77635849f30c5d68eb0b96d",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email"
                                ],
                                "properties": {
                                    "email": {
                                        "description": "The email address of the user.",
                                        "type": "string",
                                        "format": "email"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Verification code resent successfully.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Verification code resent successfully."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Email is already verified.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Email is already verified."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Too many requests.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "A verification code was recently sent. Please wait 1 minute before requesting a new code."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation error response.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "The given data was invalid."
                                        },
                                        "errors": {
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/auth/verify-email": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Verify user email",
                "description": "This endpoint verifies the user email using the verification code sent to their email address.",
                "operationId": "verifyEmail",
                "requestBody": {
                    "description": "Verification data",
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "verification_code"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "john.doe@example.com"
                                    },
                                    "verification_code": {
                                        "type": "string",
                                        "example": "123456"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Email verified successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Email verified successfully."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "409": {
                        "description": "Email is already verified.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Email is already verified."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation errors or invalid code",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Invalid verification code."
                                        },
                                        "errors": {
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "User not found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "User not found."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "tags": [
        {
            "name": "App",
            "description": "App"
        },
        {
            "name": "Auth",
            "description": "Auth"
        }
    ]
}